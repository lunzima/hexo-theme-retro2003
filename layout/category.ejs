<section class="card">
  <h2 class="card-head"><%= __('terms.category_title', page.category) %></h2>
  <div class="card-body">
    <ul class="post-list">
    <% page.posts.each(function(post){ %>
      <li class="post-item"><a href="<%- url_for(post.path) %>"><%= post.title %></a></li>
    <% }); %>
    </ul>
    <%- partial('_partial/pager') %>
  </div>
</section>
