<section class="card">
  <h2 class="card-head"><%= __('archive.title') %></h2>
  <div class="card-body">
    <ul class="post-list">
    <% page.posts.each(function(post){ %>
      <li class="post-item">
        <div class="post-item-meta"><%= date(post.date, 'YYYY-MM-DD') %></div>
        <h3 class="post-item-title"><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3>
      </li>
    <% }); %>
    </ul>
    <%- partial('_partial/pager') %>
  </div>
</section>
